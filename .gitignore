# ── Model checkpoints & large data (use HuggingFace Hub for these) ──
experiments/*/checkpoints/*.pt
experiments/*/cache/
*.pt
*.bin
*.safetensors

# ── Python ──
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── LaTeX build artifacts ──
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz
paper/*.toc

# ── OS / IDE ──
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# ── Data (too large for git) ──
*.jsonl
!configs/*.yaml
